<UserControl
    x:Class="Desktop.App.Controls.VirtualKeyboardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="Bahnschrift"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Key button base style -->
        <Style x:Key="VK.Key" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Action.PrimarySurface}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action key (Backspace, Enter) -->
        <Style x:Key="VK.KeyAction" BasedOn="{StaticResource VK.Key}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Action.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Wide key (Space, 0 in numpad) -->
        <Style x:Key="VK.KeyWide" BasedOn="{StaticResource VK.Key}" TargetType="Button">
            <Setter Property="Width" Value="NaN" />
        </Style>

        <!-- Shift key toggle style (ToggleButton cannot BasedOn Button — copy setters) -->
        <Style x:Key="VK.KeyShift" TargetType="ToggleButton">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Action.PrimarySurface}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Action.Primary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Close button in drag handle -->
        <Style x:Key="VK.CloseButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Status.FaultSurface}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Fault}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Outer container with drag handle header -->
    <Border
        Background="{DynamicResource Brush.Surface.Panel}"
        BorderBrush="{DynamicResource Brush.Border.Default}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="20"
                Direction="270"
                Opacity="0.18"
                ShadowDepth="4" />
        </Border.Effect>

        <StackPanel>
            <!-- ── Drag Handle bar ── -->
            <Border
                x:Name="DragHandle"
                Height="32"
                Background="{DynamicResource Brush.Surface.Subpanel}"
                CornerRadius="12,12,0,0"
                Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />   <!-- left padding -->
                        <ColumnDefinition Width="*" />    <!-- dots (center) -->
                        <ColumnDefinition Width="32" />   <!-- close button -->
                    </Grid.ColumnDefinitions>

                    <!-- Drag dots indicator -->
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Ellipse Width="4" Height="4" Margin="3,0" Fill="{DynamicResource Brush.Border.Strong}" />
                        <Ellipse Width="4" Height="4" Margin="3,0" Fill="{DynamicResource Brush.Border.Strong}" />
                        <Ellipse Width="4" Height="4" Margin="3,0" Fill="{DynamicResource Brush.Border.Strong}" />
                        <Ellipse Width="4" Height="4" Margin="3,0" Fill="{DynamicResource Brush.Border.Strong}" />
                        <Ellipse Width="4" Height="4" Margin="3,0" Fill="{DynamicResource Brush.Border.Strong}" />
                    </StackPanel>

                    <!-- Close button — tắt bàn phím -->
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="✕"
                        Style="{StaticResource VK.CloseButton}"
                        Click="OnCloseClick" />
                </Grid>
            </Border>

            <!-- ── Keyboard content switcher ── -->
            <Grid x:Name="KeyboardRoot" Margin="10,8,10,10">

                <!-- ════════════════════════════ ALPHANUMERIC KEYBOARD ════════════════════════════ -->
                <StackPanel x:Name="MainLayout">

                    <!-- Number row -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="1" Style="{StaticResource VK.Key}" Tag="1" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="2" Style="{StaticResource VK.Key}" Tag="2" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="3" Style="{StaticResource VK.Key}" Tag="3" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="4" Style="{StaticResource VK.Key}" Tag="4" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="5" Style="{StaticResource VK.Key}" Tag="5" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="6" Style="{StaticResource VK.Key}" Tag="6" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="7" Style="{StaticResource VK.Key}" Tag="7" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="8" Style="{StaticResource VK.Key}" Tag="8" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="9" Style="{StaticResource VK.Key}" Tag="9" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="0" Style="{StaticResource VK.Key}" Tag="0" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="⌫" Style="{StaticResource VK.KeyAction}" Width="58" Height="40" Margin="2" Click="OnBackspaceClick" />
                    </StackPanel>

                    <!-- QWERTY row 1 -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="q" x:Name="Key_Q" Style="{StaticResource VK.Key}" Tag="q" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="w" x:Name="Key_W" Style="{StaticResource VK.Key}" Tag="w" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="e" x:Name="Key_E" Style="{StaticResource VK.Key}" Tag="e" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="r" x:Name="Key_R" Style="{StaticResource VK.Key}" Tag="r" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="t" x:Name="Key_T" Style="{StaticResource VK.Key}" Tag="t" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="y" x:Name="Key_Y" Style="{StaticResource VK.Key}" Tag="y" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="u" x:Name="Key_U" Style="{StaticResource VK.Key}" Tag="u" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="i" x:Name="Key_I" Style="{StaticResource VK.Key}" Tag="i" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="o" x:Name="Key_O" Style="{StaticResource VK.Key}" Tag="o" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="p" x:Name="Key_P" Style="{StaticResource VK.Key}" Tag="p" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                    </StackPanel>

                    <!-- QWERTY row 2 -->
                    <StackPanel Margin="22,0,0,0" Orientation="Horizontal">
                        <Button Content="a" x:Name="Key_A" Style="{StaticResource VK.Key}" Tag="a" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="s" x:Name="Key_S" Style="{StaticResource VK.Key}" Tag="s" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="d" x:Name="Key_D" Style="{StaticResource VK.Key}" Tag="d" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="f" x:Name="Key_F" Style="{StaticResource VK.Key}" Tag="f" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="g" x:Name="Key_G" Style="{StaticResource VK.Key}" Tag="g" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="h" x:Name="Key_H" Style="{StaticResource VK.Key}" Tag="h" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="j" x:Name="Key_J" Style="{StaticResource VK.Key}" Tag="j" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="k" x:Name="Key_K" Style="{StaticResource VK.Key}" Tag="k" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="l" x:Name="Key_L" Style="{StaticResource VK.Key}" Tag="l" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                    </StackPanel>

                    <!-- QWERTY row 3 + Shift -->
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton
                            x:Name="ShiftToggle"
                            Content="⇧"
                            Width="62"
                            Height="40"
                            Margin="2"
                            Style="{StaticResource VK.KeyShift}"
                            Checked="ShiftToggle_Changed"
                            Unchecked="ShiftToggle_Changed" />
                        <Button Content="z" x:Name="Key_Z" Style="{StaticResource VK.Key}" Tag="z" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="x" x:Name="Key_X" Style="{StaticResource VK.Key}" Tag="x" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="c" x:Name="Key_C" Style="{StaticResource VK.Key}" Tag="c" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="v" x:Name="Key_V" Style="{StaticResource VK.Key}" Tag="v" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="b" x:Name="Key_B" Style="{StaticResource VK.Key}" Tag="b" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="n" x:Name="Key_N" Style="{StaticResource VK.Key}" Tag="n" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="m" x:Name="Key_M" Style="{StaticResource VK.Key}" Tag="m" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="⌫" Style="{StaticResource VK.KeyAction}" Width="62" Height="40" Margin="2" Click="OnBackspaceClick" />
                    </StackPanel>

                    <!-- Bottom row: special + space + enter -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="@" Style="{StaticResource VK.Key}" Tag="@" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="." Style="{StaticResource VK.Key}" Tag="." Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="-" Style="{StaticResource VK.Key}" Tag="-" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button Content="_" Style="{StaticResource VK.Key}" Tag="_" Click="OnAlphaKeyClick" Width="42" Height="40" Margin="2" />
                        <Button
                            Content="SPACE"
                            Style="{StaticResource VK.Key}"
                            Tag=" "
                            Click="OnAlphaKeyClick"
                            Width="130"
                            Height="40"
                            Margin="2"
                            FontSize="11" />
                        <Button
                            Content="⏎ Enter"
                            Style="{StaticResource VK.KeyAction}"
                            Width="80"
                            Height="40"
                            Margin="2"
                            FontSize="12"
                            Click="OnConfirmClick" />
                    </StackPanel>

                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
