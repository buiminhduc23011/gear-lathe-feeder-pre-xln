<UserControl
    x:Class="Desktop.App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:converters="clr-namespace:Desktop.App.Converters"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:shared="clr-namespace:Desktop.App.Views.Shared"
    xmlns:behaviors="clr-namespace:Desktop.App.Behaviors"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:ResponsiveColumnsConverter x:Key="ResponsiveColumnsConverter" />

        <Style x:Key="SettingsSegmentButton" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subpanel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Root"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Action.Primary}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Action.PrimarySurface}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsParameterCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subpanel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style
            x:Key="SettingsParameterValueTextBox"
            BasedOn="{StaticResource FilterToolbarTextBox}"
            TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        </Style>

        <DataTemplate x:Key="SettingsParameterItemTemplate">
            <Border Style="{StaticResource SettingsParameterCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="16" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="{Binding Label}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,3,6,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource Brush.Text.Secondary}"
                        Text="{Binding Address}" />

                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,3,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Style="{StaticResource SettingsParameterValueTextBox}"
                        Text="{Binding ValueText, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="4,3,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{DynamicResource Brush.Action.Confirm}"
                        Text="{Binding SyncGlyph}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource Brush.Action.Danger}"
                        Text="{Binding ValidationMessage}"
                        Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <shared:PageScaffold PageSubtitle="{Binding Subtitle}" PageTitle="{Binding Title}">
        <shared:PageScaffold.BodyContent>
            <StackPanel>
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                    <ToggleButton
                        Command="{Binding SelectMachineSettingsTabCommand}"
                        Content="Cài đặt máy"
                        IsChecked="{Binding IsMachineSettingsTabSelected, Mode=OneWay}"
                        Style="{StaticResource SettingsSegmentButton}" />
                    <ToggleButton
                        Command="{Binding SelectDataTrayCartTabCommand}"
                        Content="Thông số khay/xe"
                        IsChecked="{Binding IsDataTrayCartTabSelected, Mode=OneWay}"
                        Style="{StaticResource SettingsSegmentButton}" />
                    <ToggleButton
                        Command="{Binding SelectDataMachineTabCommand}"
                        Content="Thông số máy"
                        IsChecked="{Binding IsDataMachineTabSelected, Mode=OneWay}"
                        Style="{StaticResource SettingsSegmentButton}" />
                    <ToggleButton
                        Command="{Binding SelectDataOriginCheckTabCommand}"
                        Content="Thông số Check gốc"
                        IsChecked="{Binding IsDataOriginCheckTabSelected, Mode=OneWay}"
                        Style="{StaticResource SettingsSegmentButton}" />
                    <ToggleButton
                        Command="{Binding SelectAgvSettingsTabCommand}"
                        Content="Hệ thống AGV"
                        IsChecked="{Binding IsAgvSettingsTabSelected, Mode=OneWay}"
                        Style="{StaticResource SettingsSegmentButton}" />
                    <ToggleButton
                        Command="{Binding SelectTraySettingsTabCommand}"
                        Content="Cài đặt Tray"
                        IsChecked="{Binding IsTraySettingsTabSelected, Mode=OneWay}"
                        Style="{StaticResource SettingsSegmentButton}" />
                </StackPanel>

                <StackPanel IsEnabled="{Binding IsEditable}" Visibility="{Binding IsMachineSettingsTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource SectionTitleText}"
                                    Text="Thông tin máy" />
                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource ParameterLabel}"
                                    Text="Tên máy" />
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Style="{StaticResource FilterToolbarTextBox}"
                                    Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource ParameterLabel}"
                                    Text="Machine Code" />
                                <TextBox
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource FilterToolbarTextBox}"
                                    Text="{Binding MachineCode, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource ParameterLabel}"
                                    Text="Mô tả" />
                                <TextBox
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    MinHeight="80"
                                    Margin="0,12,0,0"
                                    VerticalContentAlignment="Top"
                                    AcceptsReturn="True"
                                    Style="{StaticResource FilterToolbarTextBox}"
                                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="Kết nối" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Width="Auto"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource ParameterLabel}"
                                        Text="UrlBase Server" />
                                    <TextBox
                                        Grid.Column="1"
                                        Margin="0,6,0,0"
                                        Style="{StaticResource FilterToolbarTextBox}"
                                        Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <TextBlock
                                    Margin="0,20,0,0"
                                    Style="{StaticResource SectionTitleText}"
                                    Text="Giao diện" />
                                <CheckBox
                                    Margin="0,12,0,0"
                                    Content="Hiển thị bàn phím ảo"
                                    Foreground="{DynamicResource Brush.Text.Primary}"
                                    IsChecked="{Binding VirtualKeyboardEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Cài đặt PLC: Robot / Line 1 / Line 2  -->
                    <Border Margin="0,10,0,0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Headers  -->
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SectionTitleText}"
                                Text="PLC Robot" />
                            <TextBlock
                                Grid.Column="3"
                                Style="{StaticResource SectionTitleText}"
                                Text="PLC Line 1" />
                            <TextBlock
                                Grid.Column="5"
                                Style="{StaticResource SectionTitleText}"
                                Text="PLC Line 2" />

                            <!--  IP PLC  -->
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                Style="{StaticResource ParameterLabel}"
                                Text="IP PLC" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,12,0,0"
                                Style="{StaticResource FilterToolbarTextBox}"
                                Text="{Binding PlcHost, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="3"
                                Margin="0,12,0,0"
                                Style="{StaticResource FilterToolbarTextBox}"
                                Text="{Binding PlcLine1Host, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="5"
                                Margin="0,12,0,0"
                                Style="{StaticResource FilterToolbarTextBox}"
                                Text="{Binding PlcLine2Host, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  Port PLC  -->
                            <TextBlock
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                Style="{StaticResource ParameterLabel}"
                                Text="Port PLC" />
                            <TextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,12,0,0"
                                Style="{StaticResource FilterToolbarTextBox}"
                                Text="{Binding PlcPort, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Row="2"
                                Grid.Column="3"
                                Margin="0,12,0,0"
                                Style="{StaticResource FilterToolbarTextBox}"
                                Text="{Binding PlcLine1Port, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Row="2"
                                Grid.Column="5"
                                Margin="0,12,0,0"
                                Style="{StaticResource FilterToolbarTextBox}"
                                Text="{Binding PlcLine2Port, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  PLC ID  -->
                            <TextBlock
                                Grid.Row="3"
                                Margin="0,12,0,0"
                                Style="{StaticResource ParameterLabel}"
                                Text="PLC ID" />
                            <TextBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,12,0,0"
                                Style="{StaticResource FilterToolbarTextBox}"
                                Text="{Binding PlcId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Row="3"
                                Grid.Column="3"
                                Margin="0,12,0,0"
                                Style="{StaticResource FilterToolbarTextBox}"
                                Text="{Binding PlcLine1Id, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Row="3"
                                Grid.Column="5"
                                Margin="0,12,0,0"
                                Style="{StaticResource FilterToolbarTextBox}"
                                Text="{Binding PlcLine2Id, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  Type PLC  -->
                            <TextBlock
                                Grid.Row="4"
                                Margin="0,12,0,0"
                                Style="{StaticResource ParameterLabel}"
                                Text="Type PLC" />
                            <ComboBox
                                Grid.Row="4"
                                Grid.Column="1"
                                Margin="0,12,0,0"
                                ItemsSource="{Binding PlcTypes}"
                                SelectedItem="{Binding SelectedPlcType, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource FilterToolbarComboBox}" />
                            <ComboBox
                                Grid.Row="4"
                                Grid.Column="3"
                                Margin="0,12,0,0"
                                ItemsSource="{Binding PlcTypes}"
                                SelectedItem="{Binding SelectedPlcLine1Type, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource FilterToolbarComboBox}" />
                            <ComboBox
                                Grid.Row="4"
                                Grid.Column="5"
                                Margin="0,12,0,0"
                                ItemsSource="{Binding PlcTypes}"
                                SelectedItem="{Binding SelectedPlcLine2Type, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource FilterToolbarComboBox}" />

                            <!--  Scan rate  -->
                            <TextBlock
                                Grid.Row="5"
                                Margin="0,12,0,0"
                                Style="{StaticResource ParameterLabel}"
                                Text="Scan rate (ms)" />
                            <TextBox
                                Grid.Row="5"
                                Grid.Column="1"
                                Margin="0,12,0,0"
                                Style="{StaticResource FilterToolbarTextBox}"
                                Text="{Binding ScanRateMs, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Row="5"
                                Grid.Column="3"
                                Margin="0,12,0,0"
                                Style="{StaticResource FilterToolbarTextBox}"
                                Text="{Binding ScanRateLine1Ms, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Row="5"
                                Grid.Column="5"
                                Margin="0,12,0,0"
                                Style="{StaticResource FilterToolbarTextBox}"
                                Text="{Binding ScanRateLine2Ms, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <Button
                            Command="{Binding SaveCommand}"
                            Content="Lưu cấu hình"
                            Style="{StaticResource ButtonPrimary}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel IsEnabled="{Binding IsEditable}" Visibility="{Binding IsDataTrayCartTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource SectionCard.Subtle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleText}" Text="Thông số khay và xe hàng" />
                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource SectionSubtitleText}"
                                Text="Thông số mặc định của Tray và Xe Hàng." />

                            <ItemsControl Margin="0,14,0,0" ItemTemplate="{StaticResource SettingsParameterItemTemplate}" ItemsSource="{Binding DataTrayCartParameters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <primitives:UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveColumnsConverter}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel IsEnabled="{Binding IsEditable}" Visibility="{Binding IsDataMachineTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource SectionCard.Subtle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleText}" Text="Thông số máy" />
                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource SectionSubtitleText}"
                                Text="Giá trị mặc định giới hạn tốc độ, vị trí các trục tọa độ." />

                            <ItemsControl Margin="0,14,0,0" ItemTemplate="{StaticResource SettingsParameterItemTemplate}" ItemsSource="{Binding DataMachineParameters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <primitives:UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveColumnsConverter}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel IsEnabled="{Binding IsEditable}" Visibility="{Binding IsDataOriginCheckTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource SectionCard.Subtle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleText}" Text="Thông số Check Gốc" />
                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource SectionSubtitleText}"
                                Text="Tham số đo đạc tốc độ, độ lệch và vị trí gốc cho Line 1 và Line 2." />

                            <ItemsControl Margin="0,14,0,0" ItemTemplate="{StaticResource SettingsParameterItemTemplate}" ItemsSource="{Binding DataOriginCheckParameters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <primitives:UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveColumnsConverter}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- AGV Settings Tab -->
                <StackPanel IsEnabled="{Binding IsEditable}" Visibility="{Binding IsAgvSettingsTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Group Title -->
                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource SectionTitleText}" Text="Thông số kết nối AGV" />
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" Style="{StaticResource ParameterLabel}" Text="URL Base Server" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource FilterToolbarTextBox}" Text="{Binding AgvBaseUrl, UpdateSourceTrigger=PropertyChanged}" />



                                    <!-- Setting Auto Call -->
                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,32,0,0" Style="{StaticResource SectionTitleText}" Text="Thông số gọi AGV tự động" />
                                    
                                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,12,0,0" Style="{StaticResource ParameterLabel}" Text="Bật gọi tự động" />
                                    <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,12,0,0" IsChecked="{Binding AgvAutoCallEnabled}" Content="Cho phép máy tự động phát lệnh gọi AGV" Foreground="{DynamicResource Brush.Text.Primary}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,12,0,0" Style="{StaticResource ParameterLabel}" Text="Kệ 1: Gọi khi mức còn &lt;=" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource FilterToolbarTextBox}" MaxLength="3" Width="100" HorizontalAlignment="Left" Text="{Binding AgvKe1AutoCallRemainingBelow, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,12,0,0" Style="{StaticResource ParameterLabel}" Text="Kệ 2: Gọi khi mức còn &lt;=" />
                                    <TextBox Grid.Row="6" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource FilterToolbarTextBox}" MaxLength="3" Width="100" HorizontalAlignment="Left" Text="{Binding AgvKe2AutoCallRemainingBelow, UpdateSourceTrigger=PropertyChanged}" />

                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <Button
                            Command="{Binding SaveCommand}"
                            Content="Lưu cấu hình"
                            Style="{StaticResource ButtonPrimary}" />
                    </StackPanel>
                </StackPanel>

                <!-- Tray Settings Tab -->
                <StackPanel Visibility="{Binding IsTraySettingsTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Margin="0,0,0,12" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"
                        Text="Cấu hình kích thước và khoảng cách cho từng loại tray. Loại bố trí kệ (2 bé / 2 lớn / bé-lớn / lớn-bé) do AGV gửi tự động." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Tray Bé -->
                        <Border Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="Tray Bé (Small)" />
                                <TextBlock Margin="0,4,0,12" FontSize="11" Foreground="#94A3B8" Text="Mặc định: 5 hàng × 9 cột" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource ParameterLabel}" Text="Số hàng" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource FilterToolbarTextBox}" Text="{Binding SmallTrayRows, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource ParameterLabel}" Text="Số cột" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource FilterToolbarTextBox}" Text="{Binding SmallTrayCols, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource ParameterLabel}" Text="Offset hàng (mm)" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource FilterToolbarTextBox}" Text="{Binding SmallTrayRowOffset, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource ParameterLabel}" Text="Offset cột (mm)" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource FilterToolbarTextBox}" Text="{Binding SmallTrayColOffset, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Tray Lớn -->
                        <Border Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="Tray Lớn (Large)" />
                                <TextBlock Margin="0,4,0,12" FontSize="11" Foreground="#94A3B8" Text="Mặc định: 4 hàng × 8 cột" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource ParameterLabel}" Text="Số hàng" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource FilterToolbarTextBox}" Text="{Binding LargeTrayRows, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource ParameterLabel}" Text="Số cột" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource FilterToolbarTextBox}" Text="{Binding LargeTrayCols, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource ParameterLabel}" Text="Offset hàng (mm)" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource FilterToolbarTextBox}" Text="{Binding LargeTrayRowOffset, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource ParameterLabel}" Text="Offset cột (mm)" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource FilterToolbarTextBox}" Text="{Binding LargeTrayColOffset, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button Command="{Binding SaveTrayConfigCommand}" Content="Lưu cấu hình Tray" Style="{StaticResource ButtonPrimary}" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </shared:PageScaffold.BodyContent>
    </shared:PageScaffold>
</UserControl>
