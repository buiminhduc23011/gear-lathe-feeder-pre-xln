<UserControl
    x:Class="Desktop.App.Views.Pages.ReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:Desktop.App.Views.Shared"
    xmlns:pages="clr-namespace:Desktop.App.ViewModels.Pages"
    d:DataContext="{d:DesignInstance pages:ReportPageViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="ReportSegmentButton" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subpanel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Root"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Action.Primary}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Action.PrimarySurface}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportGridCheckBoxElement" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Resources>

    <shared:PageScaffold
        BodyVerticalScrollBarVisibility="Disabled"
        PageTitle="{Binding Title}"
        PageSubtitle="{Binding Subtitle}">
        <shared:PageScaffold.BodyContent>
            <Border Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Segment buttons -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16" Orientation="Horizontal">
                        <ToggleButton
                            Command="{Binding SelectProductionTabCommand}"
                            Content="Báo cáo"
                            IsChecked="{Binding IsProductionTabSelected, Mode=OneWay}"
                            Style="{StaticResource ReportSegmentButton}" />
                        <ToggleButton
                            Command="{Binding SelectAgvTabCommand}"
                            Content="Lịch sử AGV"
                            IsChecked="{Binding IsAgvTabSelected, Mode=OneWay}"
                            Style="{StaticResource ReportSegmentButton}" />
                    </StackPanel>

                    <!-- Tab: Lịch sử AGV -->
                    <Grid Grid.Row="1" Visibility="{Binding IsAgvTabVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Filter bar -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16" Orientation="Horizontal"
                                    DataContext="{Binding AgvHistory}">
                            <StackPanel Margin="0,0,16,0" Orientation="Vertical">
                                <TextBlock Style="{StaticResource ParameterLabel}" Text="Lọc ngày gọi" />
                                <DatePicker
                                    Margin="0,6,0,0"
                                    SelectedDate="{Binding SelectedDate, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource FilterToolbarDatePicker}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,16,0" Orientation="Vertical">
                                <TextBlock Style="{StaticResource ParameterLabel}" Text="Kệ hàng" />
                                <ComboBox
                                    Margin="0,6,0,0"
                                    Width="160"
                                    SelectedIndex="{Binding SelectedPositionIndex, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource FilterToolbarComboBox}">
                                    <ComboBoxItem Content="Tất cả kệ" />
                                    <ComboBoxItem Content="Kệ 1" />
                                    <ComboBoxItem Content="Kệ 2" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Bottom">
                                <Button
                                    Command="{Binding ApplyFiltersCommand}"
                                    Content="Lọc"
                                    Style="{StaticResource FilterToolbarPrimaryButton}" />
                            </StackPanel>

                            <StackPanel VerticalAlignment="Bottom" Margin="8,0,0,0">
                                <Button
                                    Command="{Binding LoadDataCommand}"
                                    Content="Tải lại"
                                    Style="{StaticResource FilterToolbarSecondaryButton}" />
                            </StackPanel>

                            <StackPanel VerticalAlignment="Bottom" Margin="8,0,0,0"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button
                                    Command="{Binding DeleteHistoryCommand}"
                                    Content="Xóa lịch sử"
                                    Style="{StaticResource FilterToolbarDangerButton}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Data grid -->
                        <DataGrid
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding AgvHistory.Items}"
                            Style="{StaticResource IndustrialDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding CreatedAtUtc, StringFormat='HH:mm:ss dd-MM-yyyy'}"
                                    ElementStyle="{StaticResource IndustrialDataGridTextElement}"
                                    Header="THỜI GIAN" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding PositionDisplay}"
                                    ElementStyle="{StaticResource IndustrialDataGridTextElement}"
                                    Header="KỆ YÊU CẦU" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding StatusDisplay}"
                                    ElementStyle="{StaticResource IndustrialDataGridTextElement}"
                                    Header="TRẠNG THÁI" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding MethodDisplay}"
                                    ElementStyle="{StaticResource IndustrialDataGridTextElement}"
                                    Header="PHƯƠNG THỨC" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding RemainingQty}"
                                    ElementStyle="{StaticResource IndustrialDataGridTextElement}"
                                    Header="CÒN LẠI KHI GỌI" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding DurationText}"
                                    ElementStyle="{StaticResource IndustrialDataGridTextElement}"
                                    Header="THỜI GIAN THỰC HIỆN" />
                                <DataGridTextColumn
                                    Width="2*"
                                    Binding="{Binding Note}"
                                    ElementStyle="{StaticResource IndustrialDataGridTextElement}"
                                    Header="GHI CHÚ / LỖI" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Pagination -->
                        <DockPanel
                            Grid.Row="2"
                            Margin="0,14,0,0"
                            DataContext="{Binding AgvHistory}"
                            LastChildFill="False">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodySecondaryText}"
                                Text="{Binding TotalCount, StringFormat='Tổng: {0} bản ghi'}" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button
                                    Command="{Binding GoToFirstPageCommand}"
                                    Content="|&lt;"
                                    IsEnabled="{Binding CanGoPreviousPage}"
                                    Style="{StaticResource PagerButton}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding GoToPreviousPageCommand}"
                                    Content="&lt;"
                                    IsEnabled="{Binding CanGoPreviousPage}"
                                    Style="{StaticResource PagerButton}" />
                                <Border
                                    Margin="8,0,0,0"
                                    Padding="12,0"
                                    VerticalAlignment="Stretch"
                                    Style="{StaticResource StatusBadge.Info}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource StatusBadgeText.Info}"
                                        Text="{Binding PageStatusText}" />
                                </Border>
                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding GoToNextPageCommand}"
                                    Content="&gt;"
                                    IsEnabled="{Binding CanGoNextPage}"
                                    Style="{StaticResource PagerButton}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding GoToLastPageCommand}"
                                    Content="&gt;|"
                                    IsEnabled="{Binding CanGoNextPage}"
                                    Style="{StaticResource PagerButton}" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>

                                        <!-- Tab: Bao cao -->
                                          <Grid Grid.Row="1" Visibility="{Binding DataContext.IsProductionTabVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                          DataContext="{Binding ProductionLifecycle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16" Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0" Orientation="Vertical">
                                <TextBlock Style="{StaticResource ParameterLabel}" Text="Kệ" />
                                <ComboBox
                                    Margin="0,6,0,0"
                                    Width="160"
                                    SelectedIndex="{Binding SelectedShelfIndex, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource FilterToolbarComboBox}">
                                    <ComboBoxItem Content="Tất cả kệ" />
                                    <ComboBoxItem Content="Kệ 1" />
                                    <ComboBoxItem Content="Kệ 2" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,16,0" Orientation="Vertical">
                                <TextBlock Style="{StaticResource ParameterLabel}" Text="Trạng thái" />
                                <ComboBox
                                    Margin="0,6,0,0"
                                    Width="180"
                                    SelectedIndex="{Binding SelectedStatusIndex, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource FilterToolbarComboBox}">
                                    <ComboBoxItem Content="Tất cả" />
                                    <ComboBoxItem Content="Đã tạo" />
                                    <ComboBoxItem Content="AGV đã lấy" />
                                    <ComboBoxItem Content="Đã load" />
                                    <ComboBoxItem Content="Đang sản xuất" />
                                    <ComboBoxItem Content="Hoàn thành" />
                                    <ComboBoxItem Content="Đã hủy" />
                                    <ComboBoxItem Content="Đã hủy" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Bottom">
                                <Button
                                    Command="{Binding ApplyFiltersCommand}"
                                    Content="Lọc"
                                    Style="{StaticResource FilterToolbarPrimaryButton}" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom" Margin="8,0,0,0">
                                <Button
                                    Command="{Binding LoadDataCommand}"
                                    Content="Tải lại"
                                    Style="{StaticResource FilterToolbarSecondaryButton}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Margin="0,0,0,12" Style="{StaticResource BodySecondaryText}">
                            <Run Text="Tổng declaration " />
                            <Run Text="{Binding TotalDeclarations}" />
                            <Run Text=" | Đang chạy " />
                            <Run Text="{Binding InProgressDeclarations}" />
                            <Run Text=" | Hoàn thành " />
                            <Run Text="{Binding CompletedDeclarations}" />
                            <Run Text=" | Lỗi/Hủy " />
                            <Run Text="{Binding FailedDeclarations}" />
                        </TextBlock>

                        <DataGrid
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding Items}"
                            Style="{StaticResource IndustrialDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Binding="{Binding DeclarationId}" ElementStyle="{StaticResource IndustrialDataGridTextElement}" Header="DECLARATION" />
                                <DataGridTextColumn Width="*" Binding="{Binding ShelfIndex}" ElementStyle="{StaticResource IndustrialDataGridTextElement}" Header="KỆ" />
                                <DataGridTextColumn Width="*" Binding="{Binding StatusDisplay}" ElementStyle="{StaticResource IndustrialDataGridTextElement}" Header="TRẠNG THÁI" />
                                <DataGridCheckBoxColumn Width="*" Binding="{Binding IsLoadingParameters}" ElementStyle="{StaticResource ReportGridCheckBoxElement}" Header="LOADING" />
                                <DataGridTextColumn Width="2*" Binding="{Binding CreatedAtUtc, StringFormat='HH:mm:ss dd-MM-yyyy'}" ElementStyle="{StaticResource IndustrialDataGridTextElement}" Header="THỜI ĐIỂM TẠO" />
                                <DataGridTextColumn Width="*" Binding="{Binding AgvPickupDurationSeconds}" ElementStyle="{StaticResource IndustrialDataGridTextElement}" Header="AGV (s)" />
                                <DataGridTextColumn Width="*" Binding="{Binding ProductionDurationSeconds}" ElementStyle="{StaticResource IndustrialDataGridTextElement}" Header="SẢN XUẤT (s)" />
                                <DataGridTextColumn Width="*" Binding="{Binding LifecycleDurationSeconds}" ElementStyle="{StaticResource IndustrialDataGridTextElement}" Header="TỔNG TG (s)" />
                                <DataGridTextColumn Width="3*" Binding="{Binding OrderSummary}" ElementStyle="{StaticResource IndustrialDataGridTextElement}" Header="ORDER CON" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel
                            Grid.Row="3"
                            Margin="0,14,0,0"
                            LastChildFill="False">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button
                                    Command="{Binding GoToFirstPageCommand}"
                                    Content="|&lt;"
                                    IsEnabled="{Binding CanGoPreviousPage}"
                                    Style="{StaticResource PagerButton}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding GoToPreviousPageCommand}"
                                    Content="&lt;"
                                    IsEnabled="{Binding CanGoPreviousPage}"
                                    Style="{StaticResource PagerButton}" />
                                <Border
                                    Margin="8,0,0,0"
                                    Padding="12,0"
                                    VerticalAlignment="Stretch"
                                    Style="{StaticResource StatusBadge.Info}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource StatusBadgeText.Info}"
                                        Text="{Binding PageStatusText}" />
                                </Border>
                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding GoToNextPageCommand}"
                                    Content="&gt;"
                                    IsEnabled="{Binding CanGoNextPage}"
                                    Style="{StaticResource PagerButton}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding GoToLastPageCommand}"
                                    Content="&gt;|"
                                    IsEnabled="{Binding CanGoNextPage}"
                                    Style="{StaticResource PagerButton}" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>

                </Grid>
            </Border>
        </shared:PageScaffold.BodyContent>
    </shared:PageScaffold>
</UserControl>
