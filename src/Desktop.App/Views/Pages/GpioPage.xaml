<UserControl
    x:Class="Desktop.App.Views.Pages.GpioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:resources="clr-namespace:Desktop.App.Resources"
    xmlns:shared="clr-namespace:Desktop.App.Views.Shared"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="TagStatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Offline}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="OK">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Running}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NG">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Fault}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GpioSegmentButton" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subpanel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Root"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Action.Primary}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Action.PrimarySurface}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <shared:PageScaffold PageTitle="Giám sát IO" PageSubtitle="Theo dõi inputs, outputs và bảng tag PLC.">
        <shared:PageScaffold.BodyContent>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                        <ToggleButton
                            Command="{Binding SelectInputTabCommand}"
                            Content="Input"
                            IsChecked="{Binding IsInputTabSelected, Mode=OneWay}"
                            Style="{StaticResource GpioSegmentButton}" />
                        <ToggleButton
                            Command="{Binding SelectOutputTabCommand}"
                            Content="Output"
                            IsChecked="{Binding IsOutputTabSelected, Mode=OneWay}"
                            Style="{StaticResource GpioSegmentButton}" />
                        <ToggleButton
                            Command="{Binding SelectDataPlcTabCommand}"
                            Content="Data PLC"
                            IsChecked="{Binding IsDataPlcTabSelected, Mode=OneWay}"
                            Style="{StaticResource GpioSegmentButton}" />
                    </StackPanel>

                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding IsInputTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Inputs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <resources:IoIndicator
                                        Address="{Binding Address}"
                                        NameIO="{Binding Name}"
                                        State="{Binding State}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding IsOutputTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Outputs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <resources:IoIndicator
                                        Address="{Binding Address}"
                                        NameIO="{Binding Name}"
                                        State="{Binding State}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDataPlcTabSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLine1TabSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLine2TabSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <hc:TextBox
                                Height="42"
                                hc:InfoElement.Placeholder="Tìm theo Tag, địa chỉ, mô tả..."
                                Style="{StaticResource FilterToolbarTextBox}"
                                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

                    
                        </Grid>

                        <DataGrid
                            Grid.Row="1"
                            IsReadOnly="True"
                            ItemsSource="{Binding Tags}"
                            Style="{StaticResource IndustrialDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="70" Binding="{Binding Index}" ElementStyle="{StaticResource IndustrialDataGridTextElement}" Header="STT" />
                                <DataGridTextColumn Width="2*" Binding="{Binding Name}" ElementStyle="{StaticResource IndustrialDataGridTextElement}" Header="Tag" />
                                <DataGridTextColumn Width="*" Binding="{Binding Address}" ElementStyle="{StaticResource IndustrialDataGridTextElement}" Header="Address" />
                                <DataGridTextColumn Width="*" Binding="{Binding DataType}" ElementStyle="{StaticResource IndustrialDataGridTextElement}" Header="Type" />
                                <DataGridTextColumn Width="*" Binding="{Binding Value}" ElementStyle="{StaticResource IndustrialDataGridTextElement}" Header="Value" />
                                <DataGridTemplateColumn Width="100" Header="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock  Style="{StaticResource TagStatusText}" Text="{Binding Status}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="140" Binding="{Binding LastUpdatedTime, StringFormat=HH:mm:ss}" ElementStyle="{StaticResource IndustrialDataGridTextElement}" Header="Updated" />
                                <DataGridTextColumn Width="2*" Binding="{Binding Description}" ElementStyle="{StaticResource IndustrialDataGridTextElement}" Header="Description" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodySecondaryText}"
                                Text="{Binding TotalCount, StringFormat='Tổng: {0} tag'}" />
                            <StackPanel
                                DockPanel.Dock="Right"
                                Orientation="Horizontal">
                                <Button
                                    Command="{Binding GoToFirstPageCommand}"
                                    Content="|&lt;"
                                    IsEnabled="{Binding CanGoPreviousPage}"
                                    Style="{StaticResource PagerButton}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding GoToPreviousPageCommand}"
                                    Content="&lt;"
                                    IsEnabled="{Binding CanGoPreviousPage}"
                                    Style="{StaticResource PagerButton}" />
                                <Border
                                    Margin="8,0,0,0"
                                    Padding="12,0"
                                    VerticalAlignment="Stretch"
                                    Style="{StaticResource StatusBadge.Info}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource StatusBadgeText.Info}"
                                        Text="{Binding PageStatusText}" />
                                </Border>
                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding GoToNextPageCommand}"
                                    Content="&gt;"
                                    IsEnabled="{Binding CanGoNextPage}"
                                    Style="{StaticResource PagerButton}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding GoToLastPageCommand}"
                                    Content="&gt;|"
                                    IsEnabled="{Binding CanGoNextPage}"
                                    Style="{StaticResource PagerButton}" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </shared:PageScaffold.BodyContent>
    </shared:PageScaffold>
</UserControl>
