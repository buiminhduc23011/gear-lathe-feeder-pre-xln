<UserControl
    x:Class="Desktop.App.Views.Dialogs.NotificationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="clr-namespace:Desktop.App.Models.Ui"
    xmlns:vm="clr-namespace:Desktop.App.ViewModels.Dialogs"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:NotificationDialogViewModel}"
    Width="420">

    <Border
        CornerRadius="{DynamicResource Radius.Card}"
        ClipToBounds="True"
        BorderBrush="{DynamicResource Brush.Border.Default}"
        BorderThickness="1">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Accent strip -->
            <Border Grid.Column="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.Status.Info}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static ui:NotificationDialogType.Error}">
                                <Setter Property="Background" Value="{DynamicResource Brush.Status.Fault}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static ui:NotificationDialogType.Warning}">
                                <Setter Property="Background" Value="{DynamicResource Brush.Status.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static ui:NotificationDialogType.Success}">
                                <Setter Property="Background" Value="{DynamicResource Brush.Status.Running}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Content area -->
            <Border Grid.Column="1" Padding="20,18,20,18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.Status.InfoSurface}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static ui:NotificationDialogType.Error}">
                                <Setter Property="Background" Value="{DynamicResource Brush.Status.FaultSurface}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static ui:NotificationDialogType.Warning}">
                                <Setter Property="Background" Value="{DynamicResource Brush.Status.WarningSurface}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static ui:NotificationDialogType.Success}">
                                <Setter Property="Background" Value="{DynamicResource Brush.Status.RunningSurface}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock
                        Text="{Binding Title}"
                        Style="{StaticResource SectionTitleText}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Text="{Binding Message}"
                        Style="{StaticResource BodySecondaryText}"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        MinWidth="100"
                        MinHeight="40"
                        Content="OK"
                        Command="{Binding DismissCommand}"
                        Style="{StaticResource ButtonPrimary}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
