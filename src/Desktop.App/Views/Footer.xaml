<UserControl
    x:Class="Desktop.App.Views.Footer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BodySecondaryText}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} | Released: {1} | Design by STI.Automation">
                        <Binding Path="VersionText" />
                        <Binding Path="BuildDateText" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <!--  PLC scan rate + badge  -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,3,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource FontFamily.Data}"
                    Foreground="{DynamicResource Brush.Text.Secondary}"
                    Text="{Binding ScanRateText, StringFormat='PLC: {0}'}" />
                <Border Margin="6,0,6,0">
                    <Border.Style>
                        <Style BasedOn="{StaticResource StatusBadge.Danger}" TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Status.RunningSurface}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Running}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ConnectionBadgeText}">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource StatusBadgeText.Danger}" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Running}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!--  Server badge  -->
                <Border Margin="6,0,6,0">
                    <Border.Style>
                        <Style BasedOn="{StaticResource StatusBadge.Danger}" TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsServerConnected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Status.RunningSurface}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Running}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ServerBadgeText}">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource StatusBadgeText.Danger}" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerConnected}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Running}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <TextBlock
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource FontFamily.Data}"
                    Foreground="{DynamicResource Brush.Text.Secondary}"
                    Style="{StaticResource BodySecondaryText}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}  {1}">
                            <Binding Path="CurrentDateText" />
                            <Binding Path="CurrentTimeText" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
