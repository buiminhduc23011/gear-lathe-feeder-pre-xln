<UserControl
    x:Class="Desktop.App.Views.Shared.PageScaffold"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">
    <Border Style="{StaticResource PageSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <ContentPresenter
                    DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Content="{Binding HeaderActionContent, ElementName=Root}">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Style.Triggers>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding PageTitle, ElementName=Root}" />
                    <TextBlock Style="{StaticResource PageSubtitleText}" Text="{Binding PageSubtitle, ElementName=Root}" />
                </StackPanel>
            </DockPanel>

            <ContentPresenter Grid.Row="1" Content="{Binding StatusContent, ElementName=Root}">
                <ContentPresenter.Style>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,20,0,0" />
                        <Style.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ContentPresenter.Style>
            </ContentPresenter>

            <ScrollViewer
                Grid.Row="2"
                Margin="0,20,0,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="{Binding BodyVerticalScrollBarVisibility, ElementName=Root}">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BodyVerticalScrollBarVisibility, ElementName=Root}" Value="Disabled">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ContentPresenter Content="{Binding BodyContent, ElementName=Root}">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Style.Triggers>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>
            </ScrollViewer>

            <ContentPresenter
                Grid.Row="2"
                Margin="0,20,0,0"
                Content="{Binding BodyContent, ElementName=Root}">
                <ContentPresenter.Style>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BodyVerticalScrollBarVisibility, ElementName=Root}" Value="Disabled">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ContentPresenter.Style>
            </ContentPresenter>

            <ContentPresenter Grid.Row="3" Content="{Binding ActionContent, ElementName=Root}">
                <ContentPresenter.Style>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,20,0,0" />
                        <Style.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ContentPresenter.Style>
            </ContentPresenter>
        </Grid>
    </Border>
</UserControl>
