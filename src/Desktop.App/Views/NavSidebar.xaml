<UserControl
    x:Class="Desktop.App.Views.NavSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:Desktop.App.Models.Ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border Margin="0,0,0,12" Style="{StaticResource ShellPanel}">
        <UniformGrid Columns="7">
            <RadioButton
                Command="{Binding ChangePageCommand}"
                CommandParameter="{x:Static enums:PageType.Auto}"
                Content="Tự động"
                GroupName="MainPages"
                IsChecked="True"
                Style="{StaticResource RadioSelectPage}" />
            <RadioButton
                Command="{Binding ChangePageCommand}"
                CommandParameter="{x:Static enums:PageType.Manual}"
                Content="Bằng tay"
                GroupName="MainPages"
                IsEnabled="{Binding IsActiveSetting}"
                Style="{StaticResource RadioSelectPage}" />
            <RadioButton
                Command="{Binding ChangePageCommand}"
                CommandParameter="{x:Static enums:PageType.Gpio}"
                Content="Giám sát IO"
                GroupName="MainPages"
                Style="{StaticResource RadioSelectPage}" />
            <RadioButton
                Command="{Binding ChangePageCommand}"
                CommandParameter="{x:Static enums:PageType.History}"
                Content="Lịch sử lỗi"
                GroupName="MainPages"
                Style="{StaticResource RadioSelectPage}" />
            <RadioButton
                Command="{Binding ChangePageCommand}"
                CommandParameter="{x:Static enums:PageType.Report}"
                Content="Báo cáo"
                GroupName="MainPages"
                Style="{StaticResource RadioSelectPage}" />
            <RadioButton
                Command="{Binding ChangePageCommand}"
                CommandParameter="{x:Static enums:PageType.Model}"
                Content="Model"
                GroupName="MainPages"
                IsEnabled="{Binding IsActiveSetting}"
                Style="{StaticResource RadioSelectPage}" />
            <RadioButton
                Command="{Binding ChangePageCommand}"
                CommandParameter="{x:Static enums:PageType.Settings}"
                Content="Cài đặt"
                GroupName="MainPages"
                IsEnabled="{Binding IsActiveSetting}"
                Style="{StaticResource RadioSelectPage}" />
        </UniformGrid>
    </Border>
</UserControl>
