<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:converters="clr-namespace:Desktop.App.Converters">

    <ResourceDictionary.MergedDictionaries>
        <hc:ThemeResources RequestedTheme="Light" />
        <hc:Theme />
        <ResourceDictionary Source="Tokens.xaml" />
        <ResourceDictionary Source="Styles.Inputs.xaml" />
        <ResourceDictionary Source="Styles.Buttons.xaml" />
        <ResourceDictionary Source="Styles.Filters.xaml" />
        <ResourceDictionary Source="Styles.Panels.xaml" />
        <ResourceDictionary Source="Styles.Display.xaml" />
        <ResourceDictionary Source="Styles.NavButton.xaml" />
        <ResourceDictionary Source="Styles.Tables.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:ActivePageConverter x:Key="ActivePageConverter" />
    <converters:RelativeTimeConverter x:Key="RelativeTimeConverter" />

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Window}" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource IndustrialCommandButton}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource FilterTextBox}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    </Style>

    <Style TargetType="DataGrid" BasedOn="{StaticResource IndustrialDataGrid}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    </Style>

    <Style TargetType="ScrollViewer" BasedOn="{StaticResource IndustrialScrollViewer}" />

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    </Style>

    <Style BasedOn="{StaticResource {x:Type hc:NumericUpDown}}" TargetType="hc:NumericUpDown">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Data}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    </Style>

</ResourceDictionary>
