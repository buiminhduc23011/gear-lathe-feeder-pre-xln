<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <ResourceDictionary.MergedDictionaries>
        <hc:ThemeResources RequestedTheme="Light" />
        <hc:Theme />
        <ResourceDictionary Source="Tokens.xaml" />
        <ResourceDictionary Source="Styles.Buttons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="FilterToolbarComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subpanel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Action.PrimarySurface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterToolbarTextBox" TargetType="TextBox">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="6,6" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subpanel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Action.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource Radius.Button}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock
                                x:Name="PlaceholderText"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Brush.Text.Secondary}"
                                IsHitTestVisible="False"
                                Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(hc:InfoElement.Placeholder)}"
                                Visibility="Collapsed" />
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Action.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterToolbarComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subpanel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FilterToolbarComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Button}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />

                                <Border Grid.Column="1" Background="Transparent">
                                    <Path
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 0 0 L 4 4 L 8 0"
                                        Stroke="{DynamicResource Brush.Text.Secondary}"
                                        StrokeThickness="1.5" />
                                </Border>
                            </Grid>
                        </Border>

                        <ToggleButton
                            x:Name="DropDownToggle"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            IsHitTestVisible="True">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Slide"
                            StaysOpen="False">
                            <Border
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                Margin="0,4,0,0"
                                Background="{DynamicResource Brush.Surface.Subpanel}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Button}">
                                <ScrollViewer MaxHeight="240">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Action.Primary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Action.Primary}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Root" Property="MinHeight" Value="38" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="FilterToolbarDatePicker"
        BasedOn="{StaticResource DatePickerExtend}"
        TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Language" Value="vi-VN" />
        <Setter Property="Height" Value="42" />
    </Style>

    <Style
        x:Key="FilterToolbarPrimaryButton"
        BasedOn="{StaticResource ButtonPrimary}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    </Style>

    <Style
        x:Key="FilterToolbarSecondaryButton"
        BasedOn="{StaticResource ButtonSecondary}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    </Style>

    <Style
        x:Key="FilterToolbarDangerButton"
        BasedOn="{StaticResource ButtonDanger}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    </Style>

    <Style x:Key="FilterToolbarHintText" TargetType="TextBlock">
        <Setter Property="Margin" Value="14,0,36,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Panel.ZIndex" Value="2" />
    </Style>
</ResourceDictionary>
