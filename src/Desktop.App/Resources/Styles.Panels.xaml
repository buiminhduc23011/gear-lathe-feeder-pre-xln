<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ShellPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Shell}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource FontFamily.App}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Panel}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Panel}" />
    </Style>

    <Style x:Key="PageSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource FontFamily.App}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Panel}" />
        <Setter Property="Padding" Value="24,16" />
    </Style>

    <Style x:Key="SectionCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource FontFamily.App}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
    </Style>

    <Style
        x:Key="SectionCard.Subtle"
        BasedOn="{StaticResource SectionCard}"
        TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subpanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    </Style>

    <Style
        x:Key="SectionCard.Danger"
        BasedOn="{StaticResource SectionCard}"
        TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.FaultSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Fault}" />
    </Style>

    <Style
        x:Key="MetricCard"
        BasedOn="{StaticResource SectionCard.Subtle}"
        TargetType="Border">
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style x:Key="IndustrialScrollBarTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IndustrialVerticalScrollThumb" TargetType="Thumb">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        x:Name="ThumbRoot"
                        Margin="7,3"
                        Background="{DynamicResource Brush.Border.Subtle}"
                        CornerRadius="7"
                        SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbRoot" Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbRoot" Property="Margin" Value="5,3" />
                            <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource Brush.Text.Secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IndustrialHorizontalScrollThumb" TargetType="Thumb">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        x:Name="ThumbRoot"
                        Margin="3,7"
                        Background="{DynamicResource Brush.Border.Subtle}"
                        CornerRadius="7"
                        SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbRoot" Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbRoot" Property="Margin" Value="3,5" />
                            <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource Brush.Text.Secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="20" />
                <Setter Property="MinWidth" Value="20" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid
                                MinWidth="{TemplateBinding MinWidth}"
                                Width="{TemplateBinding Width}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                                <Border
                                    x:Name="Rail"
                                    Width="6"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource Brush.Surface.Recessed}"
                                    CornerRadius="3"
                                    Opacity="0" />
                                <Track
                                    x:Name="PART_Track"
                                    IsDirectionReversed="True"
                                    Opacity="0">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource IndustrialScrollBarTrackButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource IndustrialVerticalScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource IndustrialScrollBarTrackButton}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Rail" Property="Opacity" Value="1" />
                                    <Setter TargetName="PART_Track" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="20" />
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid
                                MinHeight="{TemplateBinding MinHeight}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                                <Border
                                    x:Name="Rail"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Surface.Recessed}"
                                    CornerRadius="3"
                                    Opacity="0" />
                                <Track
                                    x:Name="PART_Track"
                                    Orientation="Horizontal"
                                    Opacity="0">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource IndustrialScrollBarTrackButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource IndustrialHorizontalScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource IndustrialScrollBarTrackButton}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Rail" Property="Opacity" Value="1" />
                                    <Setter TargetName="PART_Track" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IndustrialScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollContentPresenter
                            x:Name="PART_ScrollContentPresenter"
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            CanContentScroll="{TemplateBinding CanContentScroll}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Grid.Row="0"
                            Grid.Column="1"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Orientation="Vertical"
                            Style="{StaticResource {x:Type ScrollBar}}"
                            Value="{TemplateBinding VerticalOffset}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />

                        <ScrollBar
                            x:Name="PART_HorizontalScrollBar"
                            Grid.Row="1"
                            Grid.Column="0"
                            Maximum="{TemplateBinding ScrollableWidth}"
                            Orientation="Horizontal"
                            Style="{StaticResource {x:Type ScrollBar}}"
                            Value="{TemplateBinding HorizontalOffset}"
                            ViewportSize="{TemplateBinding ViewportWidth}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
