<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <FontFamily x:Key="FontFamily.App">Bahnschrift</FontFamily>
    <FontFamily x:Key="FontFamily.Data">Consolas</FontFamily>

    <SolidColorBrush x:Key="Brush.Surface.Window" Color="#EEF2F6" />
    <SolidColorBrush x:Key="Brush.Surface.Shell" Color="#DCE3EA" />
    <SolidColorBrush x:Key="Brush.Surface.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface.Subpanel" Color="#F7F9FC" />
    <SolidColorBrush x:Key="Brush.Surface.Recessed" Color="#E9EEF4" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#E3EBF7" />

    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#8A9AAF" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="#C2CDD9" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#D8E0E9" />
    <SolidColorBrush x:Key="Brush.Border.Divider" Color="#E3E9F0" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#182433" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#5D6C7D" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#99A5B2" />
    <SolidColorBrush x:Key="Brush.Text.Inverse" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Status.Running" Color="#247A50" />
    <SolidColorBrush x:Key="Brush.Status.RunningSurface" Color="#E4F4EA" />
    <SolidColorBrush x:Key="Brush.Status.Idle" Color="#7C8794" />
    <SolidColorBrush x:Key="Brush.Status.IdleSurface" Color="#EDF1F5" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="#B86E16" />
    <SolidColorBrush x:Key="Brush.Status.WarningSurface" Color="#FFF2E2" />
    <SolidColorBrush x:Key="Brush.Status.Fault" Color="#BF3A30" />
    <SolidColorBrush x:Key="Brush.Status.FaultSurface" Color="#FCE8E6" />
    <SolidColorBrush x:Key="Brush.Status.Offline" Color="#7F8B99" />
    <SolidColorBrush x:Key="Brush.Status.OfflineSurface" Color="#F0F3F6" />
    <SolidColorBrush x:Key="Brush.Status.Info" Color="#1E5FBF" />
    <SolidColorBrush x:Key="Brush.Status.InfoSurface" Color="#E6EEF9" />

    <SolidColorBrush x:Key="Brush.Action.Primary" Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.Action.PrimarySurface" Color="#E6EEF9" />
    <SolidColorBrush x:Key="Brush.Action.Confirm" Color="#247A50" />
    <SolidColorBrush x:Key="Brush.Action.ConfirmSurface" Color="#E4F4EA" />
    <SolidColorBrush x:Key="Brush.Action.Danger" Color="#BF3A30" />
    <SolidColorBrush x:Key="Brush.Action.DangerSurface" Color="#FCE8E6" />
    <SolidColorBrush x:Key="Brush.Action.NavActive" Color="#D9E5F7" />
    <SolidColorBrush x:Key="Brush.Action.NavAccent" Color="#2563EB" />

    <SolidColorBrush x:Key="Brush.IO.Active" Color="#E6F5EC" />
    <SolidColorBrush x:Key="Brush.IO.ActiveBorder" Color="#247A50" />
    <SolidColorBrush x:Key="Brush.IO.Inactive" Color="#F5F8FB" />
    <SolidColorBrush x:Key="Brush.IO.InactiveBorder" Color="#CCD6E1" />

    <CornerRadius x:Key="Radius.Button">4</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">6</CornerRadius>
    <CornerRadius x:Key="Radius.Card">6</CornerRadius>
    <CornerRadius x:Key="Radius.Badge">5</CornerRadius>

    <sys:Double x:Key="Size.Header.Height">58</sys:Double>
    <sys:Double x:Key="Size.NavButton.Height">58</sys:Double>
    <sys:Double x:Key="Size.WindowButton">34</sys:Double>
    <sys:Double x:Key="Size.ServoButton.Height">65</sys:Double>
    <sys:Double x:Key="FontSize.ServoButton">18</sys:Double>
    <sys:Double x:Key="Size.StatusDot.Large">12</sys:Double>
    <sys:Double x:Key="Size.StatusDot.Tiny">8</sys:Double>

    <sys:Double x:Key="FontSize.Display">26</sys:Double>
    <sys:Double x:Key="FontSize.H1">24</sys:Double>
    <sys:Double x:Key="FontSize.H2">18</sys:Double>
    <sys:Double x:Key="FontSize.H3">15</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Badge">11</sys:Double>
    <sys:Double x:Key="FontSize.Value">20</sys:Double>

    <Thickness x:Key="Padding.Panel">10</Thickness>
    <Thickness x:Key="Padding.Card">18</Thickness>
    <Thickness x:Key="Padding.Inner">12,8,12,8</Thickness>
    <Thickness x:Key="Padding.NavButton">16,12,16,12</Thickness>
    <Thickness x:Key="Padding.Badge">10,4,10,4</Thickness>

    <SolidColorBrush x:Key="Brush.BG.Window" Color="#EEF2F6" />
    <SolidColorBrush x:Key="Brush.BG.Shell" Color="#DCE3EA" />
    <SolidColorBrush x:Key="Brush.BG.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.BG.Input" Color="#F7F9FC" />
    <SolidColorBrush x:Key="Brush.BG.Hover" Color="#E3EBF7" />
    <SolidColorBrush x:Key="Brush.State.Offline" Color="#7F8B99" />
    <SolidColorBrush x:Key="Brush.State.Error" Color="#BF3A30" />
    <SolidColorBrush x:Key="Brush.Mode.Auto" Color="#247A50" />

    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#C2CDD9" />
    <SolidColorBrush x:Key="AppTextBrush" Color="#182433" />
    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#5D6C7D" />
    <SolidColorBrush x:Key="IoActiveBorderBrush" Color="#247A50" />
    <SolidColorBrush x:Key="IoBadgeOnlineBrush" Color="#E4F4EA" />
    <SolidColorBrush x:Key="IoBadgeOnlineTextBrush" Color="#247A50" />
    <SolidColorBrush x:Key="IoBadgeOfflineBrush" Color="#EDF1F5" />
    <SolidColorBrush x:Key="IoBadgeOfflineTextBrush" Color="#5D6C7D" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="#F7F9FC" />

</ResourceDictionary>
