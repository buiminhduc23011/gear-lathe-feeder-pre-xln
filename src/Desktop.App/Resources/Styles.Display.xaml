<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Desktop.App.Resources">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.H1}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="PageSubtitleText" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.H2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="SectionSubtitleText" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MetricLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="MetricValueText" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Value}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodySecondaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.IdleSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Idle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Badge}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Badge}" />
    </Style>

    <Style x:Key="StatusBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Badge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Idle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="StatusBadge.Running"
        BasedOn="{StaticResource StatusBadge}"
        TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.RunningSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Running}" />
    </Style>

    <Style
        x:Key="StatusBadge.Warning"
        BasedOn="{StaticResource StatusBadge}"
        TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.WarningSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Warning}" />
    </Style>

    <Style
        x:Key="StatusBadge.Danger"
        BasedOn="{StaticResource StatusBadge}"
        TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.FaultSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Fault}" />
    </Style>

    <Style
        x:Key="StatusBadge.Info"
        BasedOn="{StaticResource StatusBadge}"
        TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.InfoSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Info}" />
    </Style>

    <Style
        x:Key="StatusBadge.Neutral"
        BasedOn="{StaticResource StatusBadge}"
        TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.OfflineSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Offline}" />
    </Style>

    <Style
        x:Key="StatusBadgeText.Running"
        BasedOn="{StaticResource StatusBadgeText}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Running}" />
    </Style>

    <Style
        x:Key="StatusBadgeText.Warning"
        BasedOn="{StaticResource StatusBadgeText}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
    </Style>

    <Style
        x:Key="StatusBadgeText.Danger"
        BasedOn="{StaticResource StatusBadgeText}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Fault}" />
    </Style>

    <Style
        x:Key="StatusBadgeText.Info"
        BasedOn="{StaticResource StatusBadgeText}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Info}" />
    </Style>

    <Style
        x:Key="StatusBadgeText.Neutral"
        BasedOn="{StaticResource StatusBadgeText}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Offline}" />
    </Style>

    <Style x:Key="IoStateText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Badge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Offline}" />
    </Style>

    <Style TargetType="{x:Type local:IoIndicator}">
        <Setter Property="Width" Value="208" />
        <Setter Property="Height" Value="88" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:IoIndicator}">
                    <Border
                        x:Name="Card"
                        Padding="14,12"
                        Background="{StaticResource Brush.IO.Inactive}"
                        BorderBrush="{StaticResource Brush.IO.InactiveBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.Text.Primary}"
                                Text="{TemplateBinding NameIO}"
                                TextWrapping="Wrap" />

                            <Border
                                x:Name="StateBadge"
                                Grid.Column="1"
                                Padding="8,3"
                                VerticalAlignment="Top"
                                Background="{StaticResource Brush.Status.OfflineSurface}"
                                BorderBrush="{StaticResource Brush.Status.Offline}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Badge}">
                                <TextBlock
                                    x:Name="StateText"
                                    Style="{StaticResource IoStateText}"
                                    Text="OFF" />
                            </Border>

                            <TextBlock
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                FontFamily="{DynamicResource FontFamily.Data}"
                                FontSize="13"
                                Foreground="{DynamicResource Brush.Text.Secondary}"
                                Text="{TemplateBinding Address}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource Brush.IO.Active}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.IO.ActiveBorder}" />
                            <Setter TargetName="StateBadge" Property="Background" Value="{StaticResource Brush.Status.RunningSurface}" />
                            <Setter TargetName="StateBadge" Property="BorderBrush" Value="{StaticResource Brush.Status.Running}" />
                            <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Brush.Status.Running}" />
                            <Setter TargetName="StateText" Property="Text" Value="ON" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GpioTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TabPanel
                            x:Name="HeaderPanel"
                            Grid.Row="0"
                            Background="Transparent"
                            IsItemsHost="True" />

                        <Border Grid.Row="1" Background="Transparent" />

                        <ContentPresenter
                            x:Name="PART_SelectedContentHost"
                            Grid.Row="2"
                            Margin="0"
                            ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GpioTabItemStyle" TargetType="TabItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subpanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border
                        x:Name="TabBorder"
                        MinWidth="{TemplateBinding MinWidth}"
                        MinHeight="{TemplateBinding MinHeight}"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="10" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Action.Primary}" />
                            <Setter Property="Background" Value="{DynamicResource Brush.Action.PrimarySurface}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TabBorder" Property="Opacity" Value="0.45" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter Property="Panel.ZIndex" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
